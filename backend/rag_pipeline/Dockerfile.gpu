# ==========================================
# STAGE 1: Builder (Compiles dependencies)
# ==========================================
FROM python:3.11-slim AS builder

WORKDIR /app

# Re-use pre-installed base virtual environment containing CUDA PyTorch
COPY --from=anime_recommender-rag_pipeline_gpu:latest /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY backend/rag_pipeline/requirements.txt .

# Install remaining requirements
RUN pip install --default-timeout=1000 --no-cache-dir -r requirements.txt


# ==========================================
# STAGE 2: Runtime (Lean production image)
# ==========================================
FROM python:3.11-slim

WORKDIR /app

# Copy ONLY the finished, compiled virtual environment from the builder stage
COPY --from=builder /opt/venv /opt/venv

# Activate the virtual environment and ensure standard UTF-8 encoding
ENV PATH="/opt/venv/bin:$PATH"
ENV PYTHONPATH="/app"
ENV PYTHONUTF8="1"

# Copy the complete backend package
COPY backend /app/backend

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
